   "source": [
    "\"\"\"\n",
    "Author: Sophie A. Liu\n",
    "Date: 05/29/2026 2:30pm CDT\n",
    "Purpose: using GSEA to compare our genesets from factors\n",
    "\"\"\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "641da3ef",
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import gseapy as gp\n",
    "import matplotlib.pyplot as plt"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 76,
   "id": "f1b629c5",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_fact = pd.read_csv(\"9NMF_W.csv\")\n",
    "# df_fact = pd.read_csv(\"9NSF_W.csv\")\n",
    "df_fact = df_fact.set_index(df_fact.columns[0])                 "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "a45b766d",
   "metadata": {},
   "outputs": [],
   "source": [
    "factors = df_fact.columns"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f249f7d6",
   "metadata": {},
   "outputs": [],
   "source": [
    "gsea_list = {}\n",
    "\n",
    "for i, factor in enumerate(factors):\n",
    "    df = df_fact[[f\"V{i+1}\"]]\n",
    "    df = df.sort_values(by=f"\V{i+1}", ascending=False)\n",
    "    gsea_list[factor] = gp.prerank(\n",
    "                     rnk = df, \n",
    "                     gene_sets='Reactome_2022',         # external reference database      \n",
    "                     threads=4,\n",
    "                     min_size=5,\n",
    "                     max_size=1000,\n",
    "                     permutation_num=1000, \n",
    "                     outdir=None, \n",
    "                     seed=42,                           # the answer to life, the universe, and everything\n",
    "                     verbose=False, \n",
    "                    )"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e1206a19",
   "metadata": {},
   "outputs": [],
   "source": [
    "terms = gsea_list[\"V3\"].res2d.Term\n",
    "axs = gsea_list[\"V3\"].plot(terms = terms[0:5])"
   ]
  }
 ],
